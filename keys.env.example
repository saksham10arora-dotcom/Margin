# Margin reads API keys from three places: your environment, ~/.margin/keys.env
# (what the settings page writes; easiest is to use that page), and
# ~/.config/keys.env. Only the models you use need a key.
#
# A free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Several free accounts share the load: GEMINI_API_KEY_2, GEMINI_API_KEY_3, ...

# Any of these, if you use them:
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Claude through your Pro/Max plan: run `claude setup-token`, then
# CLAUDE_CODE_OAUTH_TOKEN=
